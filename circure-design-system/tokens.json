    "medium": { "value": { "x": "0", "y": "12", "blur": "30", "spread": "0", "color": "rgba(11, 41, 77, 0.12)" }, "type": "boxShadow", "description": "Card hover" },
    "high": { "value": { "x": "0", "y": "24", "blur": "64", "spread": "0", "color": "rgba(16, 47, 89, 0.14)" }, "type": "boxShadow", "description": "Nav dropdown surface" },
