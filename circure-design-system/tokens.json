      "eyebrow": { "value": { "fontFamily": "{typography.fontFamily.sans.value}", "fontSize": "10px", "fontWeight": 750, "letterSpacing": "0.1em", "textCase": "uppercase" }, "type": "typography" },
      "mono": { "value": { "fontFamily": "{typography.fontFamily.mono.value}", "fontSize": "9px", "fontWeight": 800, "letterSpacing": "0.06em", "textCase": "uppercase" }, "type": "typography" }
